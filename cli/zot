def cmd_ping(args):
    cfg = require_config(args)
    ok = True
    # layer 0: Zotero running + local API
    try:
        status, _ = http_get(cfg["base"].rstrip("/") + "/api/")
        print("Zotero local API : up (HTTP %s)" % status)
    except Exception as e:  # noqa: BLE001
        # /api/ may 404 but still proves the server is up; only a connection
        # error means Zotero is down.
        if isinstance(e, urllib.error.HTTPError):
            print("Zotero local API : up (HTTP %s)" % e.code)
        else:
            print("Zotero local API : DOWN (%s)" % e)
            ok = False
    # layer 2: /zotexec round-trip
    env = zotexec(cfg, "return 1 + 1;")
    if env.get("ok") and env.get("result") == 2:
        print("zotexec endpoint : up (1+1 == 2)")
    else:
        print("zotexec endpoint : FAIL (%s)" % (env.get("error") or env))
        ok = False
    # userID sanity
    print("userID           : %s" % (cfg.get("userID") or "UNKNOWN"))
    sys.exit(0 if ok else 1)


def run_js(cfg, code, timeout=120):
    """Send JS to /zotexec and return the result, or die with the error."""
    env = zotexec(cfg, code, timeout=timeout)
    if not env.get("ok"):
        die(env.get("error") or "zotexec error", code=EXIT_CONN)
    result = env.get("result")
    if isinstance(result, dict) and result.get("error"):
        die(result["error"], code=EXIT_NOTFOUND)
    return result


def cmd_search(args):
    cfg = require_config(args)
    params = {"q": args.query, "format": "json"}
    if args.item_type:
        params["itemType"] = args.item_type
    if args.tag:
        params["tag"] = args.tag
    items, total = api_list(cfg, "items", params, args.all, args.limit)
    _print_items(items, args.json)
    if not args.json:
        truncation_notice(len(items), total, args.all)


def cmd_get(args):
    cfg = require_config(args)
    key = resolve_key(cfg, args.key)
    status, body = http_get(api_url(cfg, "items/" + key))
    data = json.loads(body)
    if args.json:
        print(json.dumps(data, indent=2, ensure_ascii=False))
    else:
        d = data.get("data", data)
        for k, v in d.items():
            print("%-20s %s" % (k, v))


def cmd_cite(args):
    """Resolve a Better BibTeX citekey to its Zotero item key, title and PDF path(s)."""
    cfg = require_config(args)
    results = bbt_rpc(cfg, "item.search", [args.citekey]) or []
    match = None
    for r in results:
        if r.get("citekey") == args.citekey or r.get("citation-key") == args.citekey:
            match = r
            break
    if not match:
        die("citekey not found in Better BibTeX: %s" % args.citekey, code=EXIT_NOTFOUND)
    item_key = match.get("id", "").rstrip("/").split("/")[-1]
    atts = bbt_rpc(cfg, "item.attachments", [args.citekey]) or []
    pdfs = [a.get("path") for a in atts if str(a.get("path", "")).lower().endswith(".pdf")]
    out = {
        "citekey": args.citekey,
        "itemKey": item_key,
        "title": match.get("title"),
        "itemType": match.get("type"),
        "pdfs": pdfs,
    }
    if args.json:
        print(json.dumps(out, indent=2, ensure_ascii=False))
    else:
        print("%-10s %s" % (item_key, out["title"]))
        for p in pdfs:
            print("  PDF: " + p)


def cmd_pdf(args):
    """Print the local path(s) of the PDF attachment(s) of an item."""
    cfg = require_config(args)
    key = resolve_key(cfg, args.key)
    code = """
var it = await Zotero.Items.getByLibraryAndKeyAsync(Zotero.Libraries.userLibraryID, %r);
if (!it) return { error: 'item not found: ' + %r };
var out = [];
var atts = it.isAttachment() ? [it.id] : it.getAttachments();
for (var id of atts) {
  var att = Zotero.Items.get(id);
  if (att.attachmentContentType === 'application/pdf') {
    out.push({ attachmentKey: att.key, path: att.getFilePath(), title: att.getField('title') });
  }
}
return { itemKey: it.key, title: it.getField('title'), pdfs: out };
""" % (key, key)
    env = zotexec(cfg, code)
    if not env.get("ok"):
        die(env.get("error") or "zotexec error", code=EXIT_CONN)
    result = env.get("result") or {}
    if result.get("error"):
        die(result["error"], code=EXIT_CONN)
    pdfs = result.get("pdfs", [])
    if args.json:
        print(json.dumps(result, indent=2, ensure_ascii=False))
        return
    if not pdfs:
        die("no PDF attachments found for item %s" % args.key, code=EXIT_NOTFOUND)
    for p in pdfs:
        print(p["path"])


def cmd_collections(args):
    cfg = require_config(args)
    data, total = api_list(cfg, "collections", None, args.all, args.limit)
    if args.json:
        print(json.dumps(data, indent=2, ensure_ascii=False))
        return
    for c in data:
        d = c.get("data", {})
        meta = c.get("meta", {})
        print("%-10s %-4s %s" % (d.get("key", ""), meta.get("numItems", ""), d.get("name", "")))
    truncation_notice(len(data), total, args.all)


def cmd_tags(args):
