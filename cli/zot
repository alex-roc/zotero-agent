def _print_items(items, as_json):
    if as_json:
        print(json.dumps(items, indent=2, ensure_ascii=False))
        return
    for it in items:
        d = it.get("data", {})
        key = d.get("key", "")
        typ = d.get("itemType", "")
        title = d.get("title") or d.get("note") or "(untitled)"
        date = d.get("date", "")
        print("%-10s %-15s %-6s %s" % (key, typ, date, title))


