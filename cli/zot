#!/usr/bin/env python3
"""zot — command-line control for a local Zotero instance.

Read path  : Zotero's local HTTP API  (GET /api/users/<id>/...)  — fast.
Write path : the zotero-exec plugin    (POST /zotexec)           — arbitrary JS.

Config lives in ~/.config/zotero-exec/config.json:
    { "token": "...", "userID": 2960998, "base": "http://localhost:23119" }

Stdlib only (urllib) — no dependencies, no daemon.
"""

import argparse
