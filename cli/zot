# argparse
# --------------------------------------------------------------------------- #
def build_parser():
    p = argparse.ArgumentParser(prog="zot", description="Control a local Zotero instance.")
    sub = p.add_subparsers(dest="cmd", required=True)

    sp = sub.add_parser("ping", help="check the read API and the zotexec endpoint")
    sp.set_defaults(func=cmd_ping)

    sp = sub.add_parser("init", help="generate token, write config, auto-detect userID")
    sp.set_defaults(func=cmd_init)

    sp = sub.add_parser("search", help="full-text search items (read API)")
    sp.add_argument("query")
    sp.add_argument("--limit", type=int, default=25)
    sp.add_argument("--all", action="store_true", help="fetch all results (paginate)")
    sp.add_argument("--item-type", dest="item_type")
    sp.add_argument("--tag")
    sp.add_argument("--json", action="store_true")
    sp.set_defaults(func=cmd_search)

    sp = sub.add_parser("get", help="fetch one item by Zotero key or BBT citekey (read API)")
    sp.add_argument("key", help="Zotero item key, or a Better BibTeX citekey (prefix with @ to force)")
    sp.add_argument("--json", action="store_true")
    sp.set_defaults(func=cmd_get)

    sp = sub.add_parser("cite", help="resolve a Better BibTeX citekey to item key + PDF path(s)")
    sp.add_argument("citekey")
    sp.add_argument("--json", action="store_true")
    sp.set_defaults(func=cmd_cite)

    sp = sub.add_parser("pdf", help="print local path(s) of an item's PDF(s), by key or citekey")
    sp.add_argument("key", help="Zotero item/attachment key, or a Better BibTeX citekey (prefix with @ to force)")
    sp.add_argument("--json", action="store_true")
    sp.set_defaults(func=cmd_pdf)

    sp = sub.add_parser("collections", help="list collections (read API)")
    sp.add_argument("--limit", type=int, default=100)
    sp.add_argument("--all", action="store_true", help="fetch all (paginate)")
    sp.add_argument("--json", action="store_true")
    sp.set_defaults(func=cmd_collections)

    sp = sub.add_parser("tags", help="list tags (read API)")
    sp.add_argument("--limit", type=int, default=100)
    sp.add_argument("--all", action="store_true", help="fetch all (paginate)")
    sp.add_argument("--json", action="store_true")
    sp.set_defaults(func=cmd_tags)

    sp = sub.add_parser("export", help="export a collection's items (by key or name)")
    sp.add_argument("collection", help="collection key or name")
    sp.add_argument("--format", choices=["json", "csv", "bibtex", "biblatex", "ris"], default="json")
    sp.add_argument("--out", help="write to file instead of stdout")
    sp.set_defaults(func=cmd_export)

    sp = sub.add_parser("missing", help="list items missing a field (abstract/date/doi/url/...)")
    sp.add_argument("field", help="field name or alias: abstract, date, doi, url, publisher, publication")
    sp.add_argument("--collection", help="limit to a collection (key or name)")
    sp.add_argument("--json", action="store_true")
    sp.set_defaults(func=cmd_missing)

    sp = sub.add_parser("author", help="list items whose author matches a name")
    sp.add_argument("name")
    sp.add_argument("--json", action="store_true")
    sp.set_defaults(func=cmd_author)

    sp = sub.add_parser("notes", help="list an item's child notes (by key or citekey)")
    sp.add_argument("key")
    sp.add_argument("--json", action="store_true")
    sp.set_defaults(func=cmd_notes)

    sp = sub.add_parser("note", help="add a child note to an item (by key or citekey)")
    sp.add_argument("key")
    sp.add_argument("--file", help="read note body (HTML or text) from a file")
    sp.add_argument("--text", help="note body as a string")
    sp.add_argument("--dry-run", dest="dry_run", action="store_true", help="show what would be added, don't write")
    sp.set_defaults(func=cmd_note)

    sp = sub.add_parser("backup", help="snapshot zotero.sqlite to a timestamped file")
    sp.add_argument("--dir", help="destination dir (default: ~/.config/zotero-exec/backups)")
    sp.set_defaults(func=cmd_backup)

    sp = sub.add_parser("lint", help="report data-quality issues in the library")
    sp.add_argument("--samples", type=int, default=10, help="examples to show per issue")
    sp.add_argument("--json", action="store_true")
    sp.set_defaults(func=cmd_lint)

    sp = sub.add_parser(
        "exec",
        help="run JS via /zotexec. SOURCE is a file, '-' for stdin, or inline JS.",
    )
    sp.add_argument("source")
    sp.add_argument("--dry-run", dest="dry_run", action="store_true",
                    help="intercept writes and report what would change (best-effort)")
    sp.set_defaults(func=cmd_exec)

    return p


def main(argv=None):
    parser = build_parser()
    args = parser.parse_args(argv)
    try:
        args.func(args)
    except urllib.error.HTTPError as e:
        die("HTTP %s: %s" % (e.code, e.read().decode("utf-8", "replace")))
    except urllib.error.URLError as e:
        die("cannot reach Zotero (%s). Is it running?" % e.reason)


if __name__ == "__main__":
    main()
